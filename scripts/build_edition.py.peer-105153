"""Build the Daily Beacon static site from one edition JSON file.

    python scripts/build_edition.py [--date YYYY-MM-DD] [--edition PATH] [--out-dir PATH]
                                    [--root PATH] [--check] [--fixture] [--no-images] [--quiet]

The edition file is validated against SPEC.md section 6, then rendered into
`site/index.html`, its snapshot `site/archive/<date>.html` and the archive index
`site/archive.html`, with images optimised into `site/assets/<date>/`.

docs/SITE-CONTRACT.md is the binding element/class/attribute contract: every tag,
class and attribute below is emitted exactly as written there. Change the contract
first, never this file on its own.

Exit codes: 0 success (or CHECK OK), 1 validation/build failure, 1 unreadable input.
Nothing is written when validation fails; index.html is written through a .tmp file
so a failure never leaves a half-built page.

Console output is ASCII only (cp1252-safe when redirected).
"""

from __future__ import annotations

import argparse
import hashlib
import html as htmllib
import io
import json
import math
import re
import sys
from dataclasses import dataclass, field
from datetime import date as date_cls
from datetime import datetime
from pathlib import Path
from typing import Any, Iterable, Sequence

try:  # optional at import time so --help never crashes on a broken env
    import requests
except Exception:  # pragma: no cover - requests is a declared dependency
    requests = None  # type: ignore[assignment]

try:
    from PIL import Image
except Exception:  # pragma: no cover - Pillow is a declared dependency
    Image = None  # type: ignore[assignment]


# --------------------------------------------------------------------------- constants

ACCENTS = ("amber", "coral", "rose", "sage", "teal", "sky", "gold", "clay")
LAYOUTS = ("hero-left", "hero-centre", "hero-stacked")
KINDS = ("lead", "story", "video", "quick", "quote")
BODY_KINDS = ("lead", "story", "video", "quick")
VOID_TAGS = frozenset(
    "area base br col embed hr img input link meta param source track wbr".split()
)
RESERVED_IDS = frozenset(
    {
        "top",
        "masthead",
        "paper",
        "progress",
        "progress-bar",
        "quick-hits",
        "quick-hits-title",
        "density-toggle",
    }
)
DEFAULT_MASTHEAD = "THE DAILY BEACON"
DATE_RE = re.compile(r"^\d{4}-\d{2}-\d{2}$")
MAX_IMAGE_BYTES = 8 * 1024 * 1024
MAX_IMAGE_WIDTH = 1400
JPEG_QUALITY = 82
MAX_HTML_BYTES = 3 * 1024 * 1024
TOC_LABEL_MAX = 42
ARCHIVE_HEAD_MAX = 120
REQUEST_TIMEOUT = 20
USER_AGENT = (
    "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 "
    "(KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36"
)
DEFAULT_SETTINGS = {
    "edition_min_stories": 5,
    "edition_max_stories": 14,
    "keep_editions": 30,
}

_LINK_RE = re.compile(r"\[([^\[\]\n]+)\]\(([^()\s]+)\)")
_BOLD_RE = re.compile(r"\*\*([^\n]+?)\*\*")
_ITAL_RE = re.compile(r"(?<!\*)\*([^*\n]+?)\*(?!\*)")
_TAG_TOKEN = re.compile(
    r"<!--.*?-->"
    r"|<!DOCTYPE[^>]*>"
    r"|<\?[^>]*>"
    r"|<(/?)([A-Za-z][A-Za-z0-9:-]*)"
    r"((?:\"[^\"]*\"|'[^']*'|[^>\"'])*?)(/?)>",
    re.S | re.I,
)
_TAGS_ONLY = re.compile(r"<[^>]+>")


# ------------------------------------------------------------------------------ output

def _reconfigure_streams() -> None:
    """Never let a redirected cp1252 console crash on a stray character."""
    for name in ("stdout", "stderr"):
        stream = getattr(sys, name, None)
        if stream is None:
            continue
        try:
            stream.reconfigure(encoding="utf-8", errors="replace")  # type: ignore[attr-defined]
        except Exception:
            pass


def fail(message: str) -> int:
    print(f"BUILD FAIL: {message}", file=sys.stderr)
    return 1


def warn(message: str, quiet: bool = False) -> None:
    if not quiet:
        print(f"WARN: {message}")


# ------------------------------------------------------------------------- text helpers

def attr(value: Any) -> str:
    """Escape a value for a double-quoted attribute."""
    return htmllib.escape("" if value is None else str(value), quote=True)


def text(value: Any) -> str:
    """Escape a value for element content."""
    return htmllib.escape("" if value is None else str(value), quote=False)


def is_http(url: str) -> bool:
    lowered = str(url or "").lower()
    return lowered.startswith("http://") or lowered.startswith("https://")


def host_of(url: str) -> str:
    match = re.match(r"^https?://([^/\s]+)", str(url or ""), re.I)
    if not match:
        return ""
    return match.group(1).lower().removeprefix("www.")


def inline_errors(value: Any) -> list[str]:
    """Return every inline-markup problem in one string (spec section 6)."""
    if not isinstance(value, str):
        return ["is not a string"]
    problems: list[str] = []
    if value.count("**") % 2:
        problems.append("unbalanced ** marker")
    singles = value.replace("**", "").count("*")
    if singles % 2:
        problems.append("unbalanced * marker")
    links = _LINK_RE.findall(value)
    if value.count("[") != len(links):
        problems.append("markdown link missing ](url) or unclosed [")
    for _label, url in links:
        if not is_http(url):
            problems.append(f"markdown link is not http(s): {url}")
    return problems


def render_inline(value: Any) -> str:
    """Escape all HTML first, then apply bold / italic / link (spec section 6)."""
    escaped = htmllib.escape("" if value is None else str(value), quote=False)
    escaped = _LINK_RE.sub(
        lambda m: '<a href="{}" rel="noopener">{}</a>'.format(
            m.group(2).replace('"', "%22").replace("'", "%27"), m.group(1)
        ),
        escaped,
    )
    escaped = _BOLD_RE.sub(r"<strong>\1</strong>", escaped)
    escaped = _ITAL_RE.sub(r"<em>\1</em>", escaped)
    return escaped


def plain_text(value: Any) -> str:
    """Strip the supported inline markup, keeping the words."""
    raw = "" if value is None else str(value)
    raw = _LINK_RE.sub(lambda m: m.group(1), raw)
    raw = raw.replace("**", "").replace("*", "")
    return re.sub(r"\s+", " ", raw).strip()


def truncate(value: str, limit: int) -> str:
    if len(value) <= limit:
        return value
    if limit <= 3:
        return value[:limit]
    return value[: limit - 3].rstrip() + "..."


def slugify_id(value: Any) -> str:
    lowered = str(value or "").strip().lower()
    return re.sub(r"[^a-z0-9]+", "-", lowered).strip("-")


def priority_of(section: dict[str, Any]) -> float:
    try:
        return float(section.get("priority"))
    except (TypeError, ValueError):
        return 0.0


def parse_date(value: Any) -> date_cls | None:
    try:
        return datetime.strptime(str(value), "%Y-%m-%d").date()
    except (TypeError, ValueError):
        return None


def long_date(day: date_cls) -> str:
    return f"{day.day} {day.strftime('%B %Y')}"


def weekday_date(day: date_cls) -> str:
    return f"{day.strftime('%A')}, {long_date(day)}"


def humanise_timestamp(value: Any) -> str:
    if isinstance(value, str) and value.strip():
        try:
            moment = datetime.fromisoformat(value.replace("Z", "+00:00"))
        except ValueError:
            return value.strip()
        return moment.strftime("%d %B %Y, %H:%M")
    return datetime.now().strftime("%d %B %Y, %H:%M")


def variant_for(date_str: str) -> tuple[str, str, str, str]:
    """Date-seeded accent / layout / scale / order (SITE-CONTRACT section 3)."""
    seed = int(str(date_str).replace("-", ""))
    accent = ACCENTS[seed % 8]
    layout = LAYOUTS[(seed // 7) % 3]
    scale = "a" if (seed // 11) % 2 == 0 else "b"
    order = "lead" if (seed // 13) % 2 == 0 else "rail"
    return accent, layout, scale, order


# ------------------------------------------------------------------------- data models

@dataclass
class Issue:
    hard: bool
    message: str


@dataclass
class Asset:
    rel: str
    width: int
    height: int

    @property
    def ratio(self) -> str:
        if self.width <= 0 or self.height <= 0:
            return "16/9"
        divisor = math.gcd(self.width, self.height)
        width, height = self.width // divisor, self.height // divisor
        if max(width, height) > 40:
            factor = max(width, height) / 16.0
            width = max(1, round(width / factor))
            height = max(1, round(height / factor))
        return f"{width}/{height}"


@dataclass
class Context:
    ed: dict[str, Any]
    date: str
    prefix: str
    variants: tuple[str, str, str, str]
    assets: dict[int, Asset]
    css_q: str
    js_q: str


@dataclass
class Page:
    title: str
    description: str
    accent: str
    classes: str
    prefix: str
    css_q: str
    js_q: str
    header: str = ""
    nav: str = ""
    main: str = ""
    colophon: str = ""
    body_class: str = ""
    og_image: str = ""

# --------------------------------------------------------------------------- settings

def load_settings(root: Path) -> dict[str, Any]:
    path = root / "config" / "settings.json"
    data: dict[str, Any] = dict(DEFAULT_SETTINGS)
    try:
        loaded = json.loads(path.read_text(encoding="utf-8-sig"))
    except (OSError, ValueError):
        return data
    if isinstance(loaded, dict):
        for key, default in DEFAULT_SETTINGS.items():
            value = loaded.get(key, default)
            data[key] = value if isinstance(value, int) and value > 0 else default
    return data


def load_edition(path: Path) -> tuple[dict[str, Any] | None, str | None]:
    if not path.is_file():
        return None, f"edition not found: {path}"
    try:
        raw = path.read_text(encoding="utf-8-sig")
    except OSError as exc:
        return None, f"edition unreadable: {path} ({exc.__class__.__name__})"
    try:
        data = json.loads(raw)
    except ValueError as exc:
        return None, f"edition is not valid JSON: {path} ({exc})"
    if not isinstance(data, dict):
        return None, f"edition root must be a JSON object: {path}"
    return data, None


# ------------------------------------------------------------------------- validation

def _require_str(section: dict[str, Any], key: str, label: str, out: list[Issue]) -> None:
    value = section.get(key)
    if not isinstance(value, str) or not value.strip():
        out.append(Issue(True, f"{label}: missing required key '{key}'"))


def _check_inline(section: dict[str, Any], key: str, label: str, out: list[Issue]) -> None:
    value = section.get(key)
    if value is None:
        return
    for problem in inline_errors(value):
        out.append(Issue(True, f"{label}: bad inline markup in '{key}' ({problem})"))


def _check_body(section: dict[str, Any], kind: str, label: str, out: list[Issue]) -> None:
    if kind not in BODY_KINDS:
        return
    body = section.get("body")
    if body is None:
        out.append(Issue(True, f"{label}: missing required key 'body'"))
        return
    if isinstance(body, str):
        paragraphs = [body]
    elif isinstance(body, list):
        paragraphs = body
    else:
        out.append(Issue(True, f"{label}: 'body' must be a list of strings"))
        return
    filled = [p for p in paragraphs if isinstance(p, str) and p.strip()]
    if not filled:
        out.append(Issue(True, f"{label}: empty body"))
        return
    for index, paragraph in enumerate(paragraphs):
        if not isinstance(paragraph, str):
            out.append(Issue(True, f"{label}: body[{index}] is not a string"))
            continue
        for problem in inline_errors(paragraph):
            out.append(Issue(True, f"{label}: bad inline markup in body[{index}] ({problem})"))


def _check_image(section: dict[str, Any], label: str, out: list[Issue]) -> None:
    image = section.get("image")
    if image is None:
        return
    if not isinstance(image, dict):
        out.append(Issue(True, f"{label}: 'image' must be an object"))
        return
    src = image.get("src")
    if not isinstance(src, str) or not src.strip():
        out.append(Issue(True, f"{label}: image is missing 'src'"))


def validate_edition(ed: dict[str, Any], date_str: str) -> tuple[list[Issue], list[str], list[dict[str, Any]]]:
    """Return (issues, warnings, ordered sections). Hard issues block the build."""
    issues: list[Issue] = []
    notes: list[str] = []

    ed_date = ed.get("date")
    if not isinstance(ed_date, str) or not DATE_RE.match(ed_date):
        issues.append(Issue(True, f"edition: 'date' must be YYYY-MM-DD (got {ed_date!r})"))
    elif parse_date(ed_date) is None:
        issues.append(Issue(True, f"edition: 'date' is not a real calendar date: {ed_date}"))
    elif date_str and ed_date != date_str:
        issues.append(Issue(True, f"edition date '{ed_date}' disagrees with requested date '{date_str}'"))

    if "number" in ed and not isinstance(ed["number"], (int, str)):
        issues.append(Issue(True, "edition: 'number' must be an integer"))
    for key in ("masthead", "tagline", "signoff"):
        _check_inline(ed, key, "edition", issues)

    sections_raw = ed.get("sections")
    if not isinstance(sections_raw, list) or not sections_raw:
        issues.append(Issue(True, "edition: 'sections' must be a non-empty array"))
        sections_raw = []

    sections: list[dict[str, Any]] = []
    seen_ids: set[str] = set()
    for index, section in enumerate(sections_raw):
        if not isinstance(section, dict):
            issues.append(Issue(True, f"section[{index}]: must be an object"))
            continue
        section = dict(section)
        sections.append(section)
        kind = section.get("kind")
        label = f"section[{index}]"
        if not isinstance(kind, str) or not kind.strip():
            issues.append(Issue(True, f"{label}: missing required key 'kind'"))
            kind = ""
        elif kind not in KINDS:
            issues.append(Issue(True, f"{label}: unknown kind '{kind}' (expected one of {', '.join(KINDS)})"))
        else:
            label = f"section[{index}] ({kind})"

        raw_id = section.get("id")
        if not isinstance(raw_id, str) or not raw_id.strip():
            issues.append(Issue(True, f"{label}: missing required key 'id'"))
        else:
            if raw_id != slugify_id(raw_id):
                issues.append(Issue(True, f"{label}: id '{raw_id}' must match [a-z0-9-]+ (it is an anchor)"))
            if raw_id in RESERVED_IDS:
                issues.append(Issue(True, f"{label}: id '{raw_id}' is reserved by the page skeleton"))
            if raw_id in seen_ids:
                issues.append(Issue(True, f"{label}: duplicate section id '{raw_id}'"))
            seen_ids.add(raw_id)

        _require_str(section, "kicker", label, issues)
        _require_str(section, "headline", label, issues)
        _check_inline(section, "kicker", label, issues)
        _check_inline(section, "headline", label, issues)
        _check_inline(section, "standfirst", label, issues)
        _check_inline(section, "whyItMatters", label, issues)
        _check_inline(section, "aside", label, issues)
        _check_image(section, label, issues)

        if kind in ("story", "video", "quick", "quote"):
            if "priority" in section:
                try:
                    float(section["priority"])
                except (TypeError, ValueError):
                    issues.append(Issue(True, f"{label}: 'priority' must be numeric"))

        if kind == "quick":
            continue

        source = section.get("source")
        if not isinstance(source, dict):
            issues.append(Issue(True, f"{label}: missing required key 'source' (no source.url)"))
        else:
            url = source.get("url")
            if not isinstance(url, str) or not url.strip():
                issues.append(Issue(True, f"{label}: source.url is missing"))
            elif not is_http(url):
                issues.append(Issue(True, f"{label}: source.url is not http(s): {url}"))
            if "label" in source and not isinstance(source["label"], str):
                issues.append(Issue(True, f"{label}: source.label must be a string"))
        _check_body(section, kind, label, issues)

    leads = [s for s in sections if s.get("kind") == "lead"]
    if len(leads) > 1:
        issues.append(Issue(True, f"edition has {len(leads)} lead sections (exactly one allowed)"))

    quick_hits = ed.get("quickHits")
    if quick_hits is not None:
        if not isinstance(quick_hits, list):
            issues.append(Issue(True, "edition: 'quickHits' must be an array"))
            quick_hits = []
        for index, hit in enumerate(quick_hits):
            if not isinstance(hit, dict):
                issues.append(Issue(True, f"quickHits[{index}]: must be an object"))
                continue
            hit_text = hit.get("text")
            if not isinstance(hit_text, str) or not hit_text.strip():
                issues.append(Issue(True, f"quickHits[{index}]: missing 'text'"))
            else:
                for problem in inline_errors(hit_text):
                    issues.append(Issue(True, f"quickHits[{index}]: bad inline markup in 'text' ({problem})"))
            hit_url = hit.get("url")
            if not isinstance(hit_url, str) or not hit_url.strip():
                issues.append(Issue(True, f"quickHits[{index}]: missing 'url'"))
            elif not is_http(hit_url):
                issues.append(Issue(True, f"quickHits[{index}]: url is not http(s): {hit_url}"))

    ordered = order_sections(sections)
    if not leads and sections:
        promoted = ordered[0] if ordered else sections[0]
        notes.append(
            "no lead section - promoting '{}' to lead".format(promoted.get("id") or "first section")
        )
    return issues, notes, ordered


def order_sections(sections: Sequence[dict[str, Any]]) -> list[dict[str, Any]]:
    """Lead first, then every other section by priority desc (stable on array order)."""
    leads = [s for s in sections if s.get("kind") == "lead"]
    rest = [s for s in sections if s.get("kind") != "lead"]
    indexed = list(enumerate(rest))
    indexed.sort(key=lambda pair: (-priority_of(pair[1]), pair[0]))
    return leads[:1] + [section for _index, section in indexed]


def count_problems(issues: Iterable[Issue]) -> int:
    return sum(1 for issue in issues if issue.hard)


# ----------------------------------------------------------------------------- images

def _hash8(payload: bytes) -> str:
    return hashlib.sha1(payload).hexdigest()[:8]


def _existing_asset(out_dir: Path, date_str: str, slug: str) -> Asset | None:
    """Reuse an already-built image for this slug (offline / --no-images rebuilds)."""
    folder = out_dir / "assets" / date_str
    if not folder.is_dir():
        return None
    matches = sorted(folder.glob(f"{slug}-*.jpg"))
    if not matches:
        return None
    for candidate in reversed(matches):
        asset = _measure(candidate)
        if asset is not None:
            return Asset(rel=f"assets/{date_str}/{candidate.name}", width=asset[0], height=asset[1])
    return None


def _measure(path: Path) -> tuple[int, int] | None:
    if Image is None:
        return None
    try:
        with Image.open(path) as probe:
            return int(probe.width), int(probe.height)
    except Exception:
        return None


def _optimise(raw: bytes) -> tuple[bytes, int, int] | None:
    """Verify, flatten to RGB, cap the width at 1400, re-encode as JPEG q82."""
    if Image is None:
        return None
    try:
        with Image.open(io.BytesIO(raw)) as probe:
            probe.verify()
        with Image.open(io.BytesIO(raw)) as image:
            image.load()
            if image.mode in ("RGBA", "LA", "P"):
                rgba = image.convert("RGBA")
                canvas = Image.new("RGB", rgba.size, (11, 11, 13))
                canvas.paste(rgba, mask=rgba.split()[-1])
                image = canvas
            elif image.mode != "RGB":
                image = image.convert("RGB")
            if image.width > MAX_IMAGE_WIDTH:
                height = max(1, round(image.height * MAX_IMAGE_WIDTH / image.width))
                image = image.resize((MAX_IMAGE_WIDTH, height), Image.LANCZOS)
            buffer = io.BytesIO()
            image.save(buffer, format="JPEG", quality=JPEG_QUALITY, optimize=True, progressive=True)
            return buffer.getvalue(), image.width, image.height
    except Exception:
        return None


def _download(url: str) -> tuple[bytes | None, str | None]:
    if requests is None:
        return None, "requests unavailable"
    try:
        response = requests.get(
            url,
            timeout=REQUEST_TIMEOUT,
            headers={"User-Agent": USER_AGENT, "Accept": "image/*,*/*;q=0.8"},
            stream=True,
        )
    except Exception as exc:
        return None, f"download failed ({exc.__class__.__name__})"
    try:
        if response.status_code != 200:
            return None, f"http {response.status_code}"
        declared = response.headers.get("Content-Length")
        if declared and declared.isdigit() and int(declared) > MAX_IMAGE_BYTES:
            return None, "larger than 8 MB"
        chunks: list[bytes] = []
        total = 0
        for chunk in response.iter_content(65536):
            total += len(chunk)
            if total > MAX_IMAGE_BYTES:
                return None, "larger than 8 MB"
            chunks.append(chunk)
        payload = b"".join(chunks)
        if not payload:
            return None, "empty response"
        return payload, None
    except Exception as exc:
        return None, f"download failed ({exc.__class__.__name__})"
    finally:
        try:
            response.close()
        except Exception:
            pass


def _source_bytes(src: str, edition_dir: Path) -> tuple[bytes | None, str | None]:
    if is_http(src):
        return _download(src)
    candidate = Path(src)
    if not candidate.is_absolute():
        candidate = (edition_dir / candidate).resolve()
    if not candidate.is_file():
        return None, f"local file not found: {src}"
    try:
        size = candidate.stat().st_size
    except OSError:
        return None, "local file unreadable"
    if size > MAX_IMAGE_BYTES:
        return None, "larger than 8 MB"
    try:
        return candidate.read_bytes(), None
    except OSError:
        return None, "local file unreadable"


def build_assets(
    ed: dict[str, Any],
    date_str: str,
    edition_path: Path,
    out_dir: Path,
    no_images: bool,
    quiet: bool,
) -> tuple[dict[int, Asset], int]:
    """Resolve every section image. Returns ({section index: Asset}, warning count)."""
    assets: dict[int, Asset] = {}
    warnings = 0
    sections = ed.get("sections")
    if not isinstance(sections, list):
        return assets, warnings
    for index, section in enumerate(sections):
        if not isinstance(section, dict):
            continue
        image = section.get("image")
        if not isinstance(image, dict):
            continue
        src = image.get("src")
        if not isinstance(src, str) or not src.strip():
            continue
        slug = slugify_id(section.get("id") or f"section-{index}") or f"section-{index}"
        if no_images:
            existing = _existing_asset(out_dir, date_str, slug)
            if existing is not None:
                assets[index] = existing
                continue
            warn(f"image skipped --no-images ({slug})", quiet)
            warnings += 1
            continue
        raw, error = _source_bytes(src.strip(), edition_path.parent)
        if raw is None:
            warn(f"image skipped {error}", quiet)
            warnings += 1
            continue
        optimised = _optimise(raw)
        if optimised is None:
            warn("image skipped not a decodable image", quiet)
            warnings += 1
            continue
        payload, width, height = optimised
        name = f"{slug}-{_hash8(payload)}.jpg"
        rel = f"assets/{date_str}/{name}"
        target = out_dir / "assets" / date_str / name
        if not target.is_file():
            try:
                target.parent.mkdir(parents=True, exist_ok=True)
                tmp = target.with_suffix(".jpg.tmp")
                tmp.write_bytes(payload)
                tmp.replace(target)
            except OSError as exc:
                warn(f"image skipped write failed ({exc.__class__.__name__})", quiet)
                warnings += 1
                continue
        assets[index] = Asset(rel=rel, width=width, height=height)
    return assets, warnings


def asset_query(path: Path) -> str:
    """`?v=<8 hex of the sha1 of the file bytes>`, empty when the file is missing."""
    try:
        return "?v=" + _hash8(path.read_bytes())
    except OSError:
        return ""


# --------------------------------------------------------------------------- rendering

def render_media(ctx: Context, index: int, section: dict[str, Any], lead: bool = False) -> str:
    """A figure with a reserved aspect box, or "" when the image did not resolve."""
    asset = ctx.assets.get(index)
    if asset is None:
        return ""
    image = section.get("image") if isinstance(section.get("image"), dict) else {}
    alt = str(image.get("alt") or "").strip() or plain_text(section.get("headline")) or "Edition image"
    credit = str(image.get("credit") or "").strip()
    css_class = "media media--lead" if lead else "media"
    parts = [
        f'<figure class="{css_class}">',
        f'<div class="media__box" style="--ar:{asset.ratio}">',
        '<img class="media__img" src="{}{}" alt="{}" loading="lazy" decoding="async" width="{}" height="{}">'.format(
            attr(ctx.prefix + asset.rel), attr(""), attr(alt), asset.width, asset.height
        ),
        "</div>",
    ]
    if credit:
        parts.append(f'<figcaption class="media__credit">{text(credit)}</figcaption>')
    parts.append("</figure>")
    return "".join(parts)


def render_paragraphs(section: dict[str, Any]) -> str:
    body = section.get("body")
    if isinstance(body, str):
        paragraphs = [body]
    elif isinstance(body, list):
        paragraphs = body
    else:
        paragraphs = []
    rendered = [f"<p>{render_inline(p)}</p>" for p in paragraphs if isinstance(p, str) and p.strip()]
    return "".join(rendered)


def render_source_line(section: dict[str, Any]) -> str:
    source = section.get("source")
    if not isinstance(source, dict):
        return ""
    url = str(source.get("url") or "").strip()
    if not url:
        return ""
    label = str(source.get("label") or "").strip() or host_of(url) or "source"
    return (
        '<p class="source-line"><a class="source" href="{}" target="_blank" rel="noopener">{}</a></p>'.format(
            attr(url), text(label)
        )
    )


def render_body_block(section: dict[str, Any], css_class: str = "body") -> str:
    inner = render_paragraphs(section)
    if not inner:
        return ""
    return f'<div class="{css_class}">{inner}</div>'


def render_whymatters(section: dict[str, Any]) -> str:
    value = section.get("whyItMatters")
    if not isinstance(value, str) or not value.strip():
        return ""
    return (
        '<p class="whymatters"><span class="whymatters__label">Why it matters</span> '
        f"{render_inline(value)}</p>"
    )


def render_aside(section: dict[str, Any]) -> str:
    value = section.get("aside")
    if not isinstance(value, str) or not value.strip():
        return ""
    return f'<p class="aside">{render_inline(value)}</p>'


def render_kicker(section: dict[str, Any]) -> str:
    value = section.get("kicker")
    if not isinstance(value, str) or not value.strip():
        return ""
    return f'<p class="kicker">{render_inline(value)}</p>'


def section_anchor(section: dict[str, Any], fallback: str) -> str:
    value = section.get("id")
    return value if isinstance(value, str) and value.strip() else fallback


def render_lead(ctx: Context, index: int, section: dict[str, Any]) -> str:
    anchor = attr(section_anchor(section, "lead"))
    layout = ctx.variants[1]
    url = str((section.get("source") or {}).get("url") or "").strip()
    headline = render_inline(section.get("headline"))
    linked = f'<a href="{attr(url)}">{headline}</a>' if url else headline
    standfirst = section.get("standfirst")
    parts = [
        f'<article class="lead lead--{layout}" id="{anchor}">',
        render_kicker(section),
        f'<h2 class="lead__headline">{linked}</h2>',
    ]
    if isinstance(standfirst, str) and standfirst.strip():
        parts.append(f'<p class="standfirst">{render_inline(standfirst)}</p>')
    parts.append(render_media(ctx, index, section, lead=True))
    parts.append(render_body_block(section, "lead__body body"))
    parts.append(render_whymatters(section))
    parts.append(render_aside(section))
    parts.append(render_source_line(section))
    parts.append("</article>")
    return "".join(parts)


def render_story(ctx: Context, index: int, section: dict[str, Any]) -> str:
    kind = section.get("kind")
    anchor = attr(section_anchor(section, f"story-{index}"))
    url = str((section.get("source") or {}).get("url") or "").strip()
    headline = render_inline(section.get("headline"))
    standfirst = section.get("standfirst")
    if kind == "video":
        classes = "story card card--video"
        target = ' target="_blank" rel="noopener"'
    elif kind == "quick":
        classes = "story story--brief"
        target = ""
    else:
        classes = "story"
        target = ""
    linked = f'<a href="{attr(url)}"{target}>{headline}</a>' if url else headline
    parts = [
        f'<article class="{classes}" id="{anchor}">',
        render_kicker(section),
    ]
    if kind == "video":
        parts.append(render_media(ctx, index, section))
        parts.append(f'<h2 class="story__headline">{linked}</h2>')
    else:
        parts.append(f'<h2 class="story__headline">{linked}</h2>')
        parts.append(render_media(ctx, index, section))
    if isinstance(standfirst, str) and standfirst.strip():
        parts.append(f'<p class="standfirst">{render_inline(standfirst)}</p>')
    parts.append(render_body_block(section))
    parts.append(render_whymatters(section))
    parts.append(render_aside(section))
    parts.append(render_source_line(section))
    parts.append("</article>")
    return "".join(parts)


def render_quote(ctx: Context, index: int, section: dict[str, Any]) -> str:
    anchor = attr(section_anchor(section, f"quote-{index}"))
    quote = section.get("headline")
    if not isinstance(quote, str) or not quote.strip():
        body = section.get("body")
        first = body[0] if isinstance(body, list) and body else (body if isinstance(body, str) else "")
        quote = first if isinstance(first, str) else ""
    source = section.get("source") if isinstance(section.get("source"), dict) else {}
    cite = str(source.get("label") or "").strip() or host_of(str(source.get("url") or ""))
    parts = [
        f'<blockquote class="pullquote" id="{anchor}">',
        f'<p class="pullquote__text">{render_inline(quote)}</p>',
    ]
    if cite:
        parts.append(f'<footer class="pullquote__cite">{text(cite)}</footer>')
    parts.append("</blockquote>")
    return "".join(parts)


def render_masthead(ed: dict[str, Any], day: date_cls) -> str:
    masthead = str(ed.get("masthead") or "").strip() or DEFAULT_MASTHEAD
    tagline = str(ed.get("tagline") or "").strip()
    weather = str(ed.get("weatherStrip") or "").strip()
    number = ed.get("number")
    number_text = str(number) if isinstance(number, (int, str)) and str(number).strip() else "1"
    parts = [
        '<header class="masthead" id="masthead">',
        '<div class="masthead__rule masthead__rule--thick"></div>',
        '<div class="masthead__rule"></div>',
        f'<p class="masthead__ear masthead__ear--left">No. {text(number_text)}</p>',
        f'<p class="masthead__ear masthead__ear--right">{text(weekday_date(day))}</p>',
        f'<h1 class="masthead__title">{render_inline(masthead)}</h1>',
    ]
    if tagline:
        parts.append(f'<p class="masthead__tagline">{render_inline(tagline)}</p>')
    parts.append('<div class="masthead__rule"></div>')
    parts.append('<div class="masthead__rule masthead__rule--thick"></div>')
    if weather:
        parts.append(f'<p class="masthead__weather">{render_inline(weather)}</p>')
    parts.append("</header>")
    return "".join(parts)


def render_toc(sections: Sequence[dict[str, Any]]) -> str:
    items: list[str] = []
    for index, section in enumerate(sections):
        anchor = attr(section_anchor(section, f"section-{index}"))
        kicker = plain_text(section.get("kicker"))
        label = truncate(plain_text(section.get("headline")), TOC_LABEL_MAX)
        items.append(
            '<li><a class="toc__link" href="#{}"><span class="toc__kicker">{}</span>'
            '<span class="toc__label">{}</span></a></li>'.format(anchor, text(kicker), text(label))
        )
    return (
        '<nav class="toc" aria-label="In this edition">'
        '<ul class="toc__list">' + "".join(items) + "</ul>"
        '<button class="density-toggle" type="button" aria-pressed="false">Dense</button>'
        "</nav>"
    )


def render_quick_hits(ed: dict[str, Any]) -> str:
    hits = ed.get("quickHits")
    if not isinstance(hits, list) or not hits:
        return ""
    items: list[str] = []
    for hit in hits:
        if not isinstance(hit, dict):
            continue
        url = str(hit.get("url") or "").strip()
        label = hit.get("text")
        if not url or not isinstance(label, str) or not label.strip():
            continue
        items.append(f'<li><a href="{attr(url)}" target="_blank" rel="noopener">{render_inline(label)}</a></li>')
    if not items:
        return ""
    return (
        '<aside class="quick-hits" id="quick-hits" aria-labelledby="quick-hits-title">'
        '<h2 class="quick-hits__title" id="quick-hits-title">Quick Hits</h2>'
        '<ul class="quick-hits__list">' + "".join(items) + "</ul>"
        "</aside>"
    )


def render_main(ctx: Context, sections: Sequence[dict[str, Any]], warnings: list[str]) -> str:
    """Lead, then sections by priority, with the Quick Hits rail placed per DOM order rule."""
    rail = render_quick_hits(ctx.ed)
    rail_position = ctx.variants[3]
    blocks: list[str] = []
    lead_done = False
    rail_placed = False
    for index, section in enumerate(sections):
        kind = section.get("kind")
        if kind == "lead" and not lead_done:
            blocks.append(render_lead(ctx, index, section))
            lead_done = True
            continue
        if rail and rail_position == "rail" and not rail_placed:
            blocks.append(rail)
            rail_placed = True
        if kind == "quote":
            blocks.append(render_quote(ctx, index, section))
        elif kind == "video" or kind == "quick":
            blocks.append(render_story(ctx, index, section))
        else:
            blocks.append(render_story(ctx, index, section))
    if rail and rail_position == "rail" and not rail_placed:
        blocks.append(rail)
        rail_placed = True
    if rail and rail_position == "lead" and not rail_placed:
        blocks.append(rail)
        rail_placed = True
    return '<main class="paper" id="paper">' + "".join(blocks) + "</main>"


def render_colophon(ctx: Context, sections: Sequence[dict[str, Any]], warnings: Sequence[str]) -> str:
    ed = ctx.ed
    day = parse_date(ctx.date) or date_cls.today()
    number = ed.get("number")
    number_text = str(number) if isinstance(number, (int, str)) and str(number).strip() else "1"
    stories = sum(1 for s in sections if s.get("kind") in ("story", "video", "quick", "quote"))
    hits = ed.get("quickHits") if isinstance(ed.get("quickHits"), list) else []
    hit_count = sum(1 for h in hits if isinstance(h, dict) and h.get("text") and h.get("url"))
    covered = ed.get("covered")
    covered_n = covered if isinstance(covered, int) else stories + hit_count
    suppressed = ed.get("suppressed")
    suppressed_n = suppressed if isinstance(suppressed, int) else len(warnings)
    signoff = str(ed.get("signoff") or "").strip()
    parts = [
        '<footer class="colophon">',
        '<div class="colophon__rule"></div>',
        '<ul class="colophon__meta">',
        f"<li>Edition {text(number_text)}</li>",
        f"<li>Generated {text(humanise_timestamp(ed.get('generatedAt')))}</li>",
        f"<li>{stories} stories, {hit_count} quick hits</li>",
        f"<li>{covered_n} items tracked, {suppressed_n} suppressed today</li>",
        "</ul>",
    ]
    if signoff:
        parts.append(f'<p class="colophon__signoff">{render_inline(signoff)}</p>')
    parts.extend(
        [
            '<p class="colophon__archive">Previous 30 editions are archived at '
            f'<a href="{attr(ctx.prefix)}archive.html">archive.html</a>.</p>',
            '<p class="colophon__fine">Compiled automatically at 03:00 from public feeds and creators\' '
            "uploads. No story is invented; every item links to its source.</p>",
            "</footer>",
        ]
    )
    _ = day
    return "".join(parts)


def document(page: Page) -> str:
    """Assemble the full document per SITE-CONTRACT section 2 (order is the contract)."""
    body_class = f' class="{page.body_class}"' if page.body_class else ""
    head = [
        "<!DOCTYPE html>",
        '<html lang="en" data-accent="{}" class="{}">'.format(attr(page.accent), attr(page.classes)),
        "<head>",
        '<meta charset="utf-8">',
        '<meta name="viewport" content="width=device-width,initial-scale=1">',
        '<meta name="color-scheme" content="dark light">',
        f"<title>{text(page.title)}</title>",
        f'<meta name="description" content="{attr(page.description)}">',
        f'<link rel="stylesheet" href="{attr(page.prefix + "style.css" + page.css_q)}">',
        f'<meta property="og:title" content="{attr(page.title)}">',
        f'<meta property="og:description" content="{attr(page.description)}">',
        '<meta property="og:type" content="website">',
    ]
    if page.og_image:
        head.append(f'<meta property="og:image" content="{attr(page.og_image)}">')
    head.append("</head>")
    body = [
        "<body{} id=\"top\">".format(body_class) if body_class else '<body id="top">',
        '<div id="progress" aria-hidden="true"><span id="progress-bar"></span></div>',
        page.header,
        page.nav,
        page.main,
        page.colophon,
        '<a class="to-top" href="#top" aria-label="Back to top">Top</a>',
        f'<script src="{attr(page.prefix + "app.js" + page.js_q)}" defer></script>',
        "</body>",
        "</html>",
    ]
    return "\n".join(part for part in head + body if part) + "\n"


# ----------------------------------------------------------------------- self-checks

def assembly_errors(markup: str, sections: Sequence[dict[str, Any]], toc_html: str) -> list[str]:
    """Structural checks: unique ids, resolvable toc hrefs, balanced tags."""
    problems: list[str] = []
    id_counts: dict[str, int] = {}
    for match in re.finditer(r'\sid="([^"]+)"', markup):
        id_counts[match.group(1)] = id_counts.get(match.group(1), 0) + 1
    for index, section in enumerate(sections):
        anchor = section_anchor(section, f"section-{index}")
        if id_counts.get(anchor, 0) != 1:
            problems.append(f"anchor id '{anchor}' appears {id_counts.get(anchor, 0)} times (expected 1)")
    for href in re.findall(r'href="#([^"]+)"', toc_html):
        if id_counts.get(href, 0) < 1:
            problems.append(f"toc href '#{href}' resolves to nothing")
    problems.extend(balance_errors(markup))
    return problems


def balance_errors(markup: str) -> list[str]:
    """Stack check over the tag stream, treating area/base/br/... as void."""
    problems: list[str] = []
    stack: list[str] = []
    for match in _TAG_TOKEN.finditer(markup):
        raw = match.group(0)
        if raw.startswith("<!") or raw.startswith("<?"):
            continue
        closing = match.group(1) == "/"
        name = match.group(2).lower()
        self_closing = match.group(4) == "/"
        if name in VOID_TAGS or self_closing:
            continue
        if not closing:
            stack.append(name)
            continue
        if not stack:
            problems.append(f"unbalanced tag </{name}> with nothing open")
            return problems
        if stack[-1] != name:
            if name in stack:
                while stack and stack[-1] != name:
                    stray = stack.pop()
                    problems.append(f"unbalanced tag <{stray}> (closed by </{name}>)")
                if stack:
                    stack.pop()
                continue
            problems.append(f"unbalanced tag </{name}> (open: <{stack[-1]}>)")
            return problems
        stack.pop()
    if stack:
        problems.append("unbalanced tag <{}> never closed".format(stack[-1]))
    return problems


# ------------------------------------------------------------------------ page build

def build_page(
    ed: dict[str, Any],
    date_str: str,
    sections: Sequence[dict[str, Any]],
    out_dir: Path,
    prefix: str,
) -> tuple[Page, list[str]]:
    warnings: list[str] = []
    variants = variant_for(date_str)
    accent, layout, scale, order = variants
    day = parse_date(date_str) or date_cls.today()
    assets, asset_warnings = build_assets(ed, date_str, Path("."), out_dir, True, True)
    _ = assets, asset_warnings
    ctx = Context(
        ed=ed,
        date=date_str,
        prefix=prefix,
        variants=variants,
        assets={},
        css_q=asset_query(out_dir / "style.css"),
        js_q=asset_query(out_dir / "app.js"),
    )
    main = render_main(ctx, sections, warnings)
    masthead = str(ed.get("masthead") or "").strip() or DEFAULT_MASTHEAD
    tagline = str(ed.get("tagline") or "").strip()
    page = Page(
        title=f"{plain_text(masthead)} - {long_date(day)}",
        description=plain_text(tagline) or f"The Daily Beacon for {long_date(day)}",
        accent=accent,
        classes=f"layout-{layout} scale-{scale} order-{order}",
        prefix=prefix,
        css_q=ctx.css_q,
        js_q=ctx.js_q,
        header=render_masthead(ed, day),
        nav=render_toc(sections),
        main=main,
        colophon=render_colophon(ctx, sections, warnings),
    )
    return page, warnings


def render_archive_index(
    entries: Sequence[tuple[str, str]],
    out_dir: Path,
) -> str:
    """site/archive.html - newest first, same masthead shape, no nav."""
    seed_date = entries[0][0] if entries else date_cls.today().isoformat()
    accent, layout, scale, order = variant_for(seed_date)
    day = parse_date(seed_date) or date_cls.today()
    ctx = Context(
        ed={},
        date=seed_date,
        prefix="",
        variants=(accent, layout, scale, order),
        assets={},
        css_q=asset_query(out_dir / "style.css"),
        js_q=asset_query(out_dir / "app.js"),
    )
    items = "".join(
        '<li class="archive__item"><a class="archive__link" href="archive/{}.html">'
        '<span class="archive__date">{}</span>'
        '<span class="archive__head">{}</span></a></li>'.format(attr(date_str), text(date_str), text(head))
        for date_str, head in entries
    )
    head_html = [
        '<header class="masthead" id="masthead">',
        '<div class="masthead__rule masthead__rule--thick"></div>',
        '<div class="masthead__rule"></div>',
        f'<p class="masthead__ear masthead__ear--left">No. {len(entries)}</p>',
        f'<p class="masthead__ear masthead__ear--right">{text(weekday_date(day))}</p>',
        '<h1 class="masthead__title">THE DAILY BEACON</h1>',
        '<p class="masthead__tagline">Archive</p>',
        '<div class="masthead__rule"></div>',
        '<div class="masthead__rule masthead__rule--thick"></div>',
        "</header>",
    ]
    colophon = (
        '<footer class="colophon">'
        '<div class="colophon__rule"></div>'
        '<ul class="colophon__meta">'
        f"<li>{len(entries)} editions archived</li>"
        "</ul>"
        '<p class="colophon__fine">Compiled automatically at 03:00 from public feeds and creators\' '
        "uploads. No story is invented; every item links to its source.</p>"
        "</footer>"
    )
    page = Page(
        title="THE DAILY BEACON - Archive",
        description="Every archived Daily Beacon edition, newest first.",
        accent=accent,
        classes=f"layout-{layout} scale-{scale} order-{order}",
        prefix="",
        css_q=ctx.css_q,
        js_q=ctx.js_q,
        header="".join(head_html),
        nav="",
        main='<main class="paper archive"><ul class="archive__list">' + items + "</ul></main>",
        colophon=colophon,
        body_class="page-archive",
    )
    return document(page)


def lead_headline_of(markup: str) -> str:
    """Tolerant parse of the first lead headline from a snapshot."""
    match = re.search(r'<h2 class="lead__headline">(.*?)</h2>', markup, re.S)
    if not match:
        return "Edition"
    inner = _TAGS_ONLY.sub(" ", match.group(1))
    flat = re.sub(r"\s+", " ", htmllib.unescape(inner)).strip()
    return truncate(flat, ARCHIVE_HEAD_MAX) or "Edition"


def collect_archive(out_dir: Path, current: str, current_html: str) -> list[tuple[str, str]]:
    """(date, lead headline) for every snapshot plus today, newest first."""
    seen: dict[str, str] = {}
    folder = out_dir / "archive"
    if folder.is_dir():
        for path in sorted(folder.glob("*.html")):
            stem = path.stem
            if not DATE_RE.match(stem) or parse_date(stem) is None:
                continue
            try:
                markup = path.read_text(encoding="utf-8", errors="replace")
            except OSError:
                continue
            seen[stem] = lead_headline_of(markup)
    seen[current] = lead_headline_of(current_html)
    return sorted(seen.items(), key=lambda pair: pair[0], reverse=True)


def write_text(path: Path, payload: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text(payload, encoding="utf-8", newline="\n")
    tmp.replace(path)


def count_links(markup: str) -> int:
    return len(re.findall(r"<a\s[^>]*href=", markup, re.I))
